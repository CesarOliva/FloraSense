# URL base del backend FastAPI (desarrollo local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# true (por defecto): el frontend usa respuestas simuladas de src/lib/mocks.ts.
# Cambiar a false cuando el backend tenga los endpoints listos.
NEXT_PUBLIC_USE_MOCKS=true

# Debe coincidir con MAX_UPLOAD_SIZE_MB del backend
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10
